# WALLETCHI server environment.
# Copy to .env and fill in. Every subsystem runs in a loud STUB mode until its
# credentials are present (see the stub-mode matrix in README.md). Nothing fakes
# success silently. Never commit .env or any cert/key.

# ---------- Core ----------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Public URL of THIS server (used for pass webServiceURL + email/wallet links).
# Production: https://api.playwalletchi.com
PUBLIC_BASE_URL=http://localhost:8080
# The web app origin (landing + pet pages). Used for CORS + email fallback links.
# Production: https://playwalletchi.com
WEB_APP_URL=http://localhost:3000

# ---------- Database (required, no fallback) ----------
# Local docker one-liner:
#   docker run --name punchcard-pg -e POSTGRES_PASSWORD=punchcard -e POSTGRES_DB=punchcard -p 5432:5432 -d postgres:16
# Then: DATABASE_URL below, `npm run prisma:migrate`.
# Neon fallback: create a project at neon.tech and paste its pooled connection string.
DATABASE_URL=postgresql://postgres:punchcard@localhost:5432/punchcard?schema=public

# ---------- Robinhood Chain ----------
# mainnet = chainId 4663; testnet = chainId 46630. RPC is auto-selected.
ROBINHOOD_NETWORK=testnet
# ROBINHOOD_RPC_URL=            # optional override of the built-in RPC
# READ_RPC_URL=                 # DEDICATED read RPC (STEP 8C): public fan-out reads move here so a
                                # burst against public routes can never starve the relayer's tx path.
                                # Unset = reads share the write RPC (today's behavior).
# STUCK_TX_WAIT_MS=30000        # receipt wait before a write is treated as stuck and fee-bumped
# STUCK_TX_MAX_FEE_BUMPS=2      # replacement attempts before the loud StuckTxError

# --- Mint-time captcha (Cloudflare Turnstile, STEP 8C). Armed ONLY when BOTH are set;
# a half pair is a loud boot error and the captcha stays off. Site key is served on
# /api/mint/challenge, so arming this needs no web deploy.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=
# Relayer + pet issuer. The relayer runs in STUB (MockChain) until BOTH are set.
RELAYER_PRIVATE_KEY=
RUNNER_ISSUER_ADDRESS=
# Optional, for reads/metadata only. PET721_ADDRESS is the Pet721 v2 contract
# (ownership + soulbound reads for /api/claim); falls back to RUNNER_721_ADDRESS.
RUNNER_721_ADDRESS=
PET721_ADDRESS=
ERC6551_REGISTRY_ADDRESS=0x000000006551c19487814612e58FE06813775758
# Leave unset: the server auto-resolves ../contracts/abi (committed, version
# controlled, no build needed) relative to the server package. Set explicitly to
# ../contracts/out to use fresh `forge build` artifacts. Falls back to the
# hand-written ABI in src/chain/abi.ts if the directory is missing.
# ABI_DIR=../contracts/abi

# ---------- Product ----------
# Free mint gate: the email/Privy checkout only mints while this is true.
DEMO_BYPASS_PAYMENT=false
RUNNER_SUPPLY_CAP=2000
# Secondary-market claim: server-issued nonce TTL for the wallet-proof signature.
CLAIM_NONCE_TTL_SECONDS=300

# ---------- OpenSea metadata refresh (optional) ----------
# No-ops with a log while the key is absent. OPENSEA_CHAIN is OpenSea's chain
# identifier for Robinhood Chain in their v2 API (verify before enabling).
OPENSEA_API_KEY=
OPENSEA_CHAIN=robinhood
OPENSEA_SWEEP_MINUTES=30

# ---------- Idle pet layer (the card lives between visits) ----------
IDLE_ENABLED=true
IDLE_TICK_MINUTES=45
IDLE_MAX_PUSHES_PER_HOUR=2
IDLE_QUIET_START_HOUR=23
IDLE_QUIET_END_HOUR=8
IDLE_MAX_CATCHUP_TICKS=16

# Care actions on the wallet card (HMAC-signed links; no global secret needed).
ACTION_COOLDOWN_MINUTES=10

# Virtual-pet needs (hunger/thirst/joy 0-100) + restore amounts per action.
NEED_DECAY_PER_HOUR=5
NEED_LOW_THRESHOLD=30
NEED_HAPPY_THRESHOLD=60
WANDER_DAYS=3
FEED_HUNGER_RESTORE=45
WATER_THIRST_RESTORE=45
EXPLORE_JOY_RESTORE=15
PLAY_JOY_RESTORE=35
TOY_JOY_RESTORE=25

# ---------- Survival economy (PetVault) ----------
# seasonActive stays false until SURVIVAL_ENABLED is true AND the vault address
# + relayer key are set. NOTE: SURVIVAL_ENABLED alone already fail-secures the
# public pass-download surfaces (capability URLs only).
SURVIVAL_ENABLED=false
PETVAULT_ADDRESS=
CARE_TOKEN_ADDRESS=
CARE_TOKEN_DECIMALS=18
# Last pet standing: death is the clock (permanent, no revive). CRITICAL means
# APPROACHING the deadline: inside this many hours of it the pet is flagged
# fading and its keeper is pinged while there is still time to save it.
CRITICAL_WINDOW_HOURS=12

# ---------- Silent care from the wallet pass (on-chain scoped session key) ----
# The pet owner signs ONE Alchemy Modular Account v2 grant that scopes a session
# key to care(uint256,uint8) on the PetVault and NOTHING else. The server holds
# that key, so every later tap of a pass care link feeds the pet with no website
# and no signature. The scope is enforced by the account's on-chain validation
# hooks, so the held key can only ever FEED: it cannot move the pet NFT or its
# coins anywhere except the game's own burn/pot split (grief, not theft).
#
# All three must be set or the feature stays OFF and every pass tap falls back to
# the proven owner-signed care page. Nothing half-works.
#
# Same values the web app uses (NEXT_PUBLIC_ALCHEMY_API_KEY / NEXT_PUBLIC_GAS_POLICY_ID);
# neither is a spending secret.
ALCHEMY_API_KEY=
GAS_POLICY_ID=
# AES-256-GCM key sealing the stored session keys. Long random value, 32 chars
# minimum (production refuses to boot below that). Rotating it invalidates every
# stored session, which is safe: pass taps fall back to owner-signed care and
# keepers re-arm on their next visit.
CARE_SESSION_SECRET=
# Session lifetime ceiling in hours. The server clamps whatever the client asks
# for to this, so a forgotten key cannot outlive the season. Cut from 720 (30 days):
# a stored key that outlives the season is pure downside, and a keeper who still
# wants one-tap care re-arms transparently on their next visit.
CARE_SESSION_TTL_HOURS=168

# Settlement + drama layer (inert until survival is live).
SETTLEMENT_POLL_MINUTES=10
DRAMA_POLL_MINUTES=10
DRAMA_LOOKBACK_BLOCKS=5000
DEATHFEED_MIN_HOURS=8
DRAMA_MAX_PUSHES_PER_CYCLE=200
# Finalize poke: when isOver() flips true the server submits the permissionless
# finalize() (the contract re-verifies the win, so the poke can never steer it).
SETTLEMENT_FINALIZE_POKE=true
# Optional USD framing for the pot on /api/season/board. UNSET until the CARE
# token has a real price source; never invent one.
# CARE_USD_PRICE=

# ---------- Anti-Sybil compute wall (free mint gate; default OFF) ----------
ANTI_SYBIL_ENABLED=false
POW_DIFFICULTY_BITS=20
POW_TTL_SECONDS=300
MINTS_PER_IP_PER_DAY=2
MINTS_PER_SUBNET_PER_DAY=8
FINGERPRINT_MINT_CAP=2
MINT_MIN_ELAPSED_MS=1200
# Pepper for email hashing + PoW HMAC signatures. CHANGE THIS.
SYBIL_PEPPER=dev-sybil-pepper-change-me

# ---------- Ops ----------
# Bearer that unlocks the detailed /internal/status readiness matrix. Empty =>
# the route 404s (off by default).
INTERNAL_STATUS_TOKEN=
# Reverse-proxy hops in front of this server (Express `trust proxy`). 1 = one
# proxy (Render's edge). Verify against the real hop count at wire time.
TRUST_PROXY_HOPS=1

# ---------- Privy (checkout auth) ----------
# Verification is bypassed (loud warning) until both are set.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---------- Apple Wallet ----------
# Pass signing + APNs run in STUB until PASS_CERT_P12_BASE64 + PASS_CERT_PASSWORD
# are set. Force stub with PASS_STUB_MODE=true.
PASS_STUB_MODE=true
PASS_CERT_P12_BASE64=
PASS_CERT_PASSWORD=
PASS_TYPE_ID=pass.com.walletchi.pet
APPLE_TEAM_ID=TEAMID0000
# Apple WWDR G4 cert, PEM, base64-encoded. See README for how to fetch.
APPLE_WWDR_PEM_BASE64=
ORGANIZATION_NAME=WALLETCHI
APNS_HOST=api.push.apple.com
APNS_PORT=443

# ---------- Google Wallet ----------
# STUB until GOOGLE_SA_KEY_BASE64 + GOOGLE_ISSUER_ID are set. Force with =true.
GOOGLE_WALLET_STUB=true
GOOGLE_SA_KEY_BASE64=
GOOGLE_ISSUER_ID=
GOOGLE_LOYALTY_CLASS_SUFFIX=walletchi_v1

# ---------- Email (Resend) ----------
# STUB until RESEND_API_KEY is set. Force with EMAIL_STUB=true.
RESEND_API_KEY=
EMAIL_FROM=WALLETCHI <onboarding@resend.dev>
# EMAIL_STUB=true

# --- TAX ECONOMY (2026-08-17): launchpad-fee reward pipeline (all address-gated) ---
# taxRewardsLive requires ALL of: relayer, TAX_DISTRIBUTOR, FEE_SPLITTER, HOLDER_VAULT,
# FEE_TOKEN, CARE_TOKEN. Unset = the whole pipeline stays dark (warming state).
TAX_DISTRIBUTOR_ADDRESS=
FEE_SPLITTER_ADDRESS=
HOLDER_VAULT_ADDRESS=
FEE_TOKEN_ADDRESS=
# DEDICATED holder-round poster key (0x-prefixed), SEPARATE from RELAYER_PRIVATE_KEY.
# HolderMerkleVault.postRound is gated on poster(), and the deploy script refuses to set
# poster == relayer, so without this the server posts nothing (every round reverts NotPoster).
# Unset = round posting stays dark with a loud boot error; reads and gasless claims for
# already-posted rounds keep working. This wallet needs its OWN gas: fund the address.
HOLDER_POSTER_PRIVATE_KEY=
REWARDS_SINK_MUX_ADDRESS=
# The care token's deploy block (holder snapshots scan Transfer logs from here).
FEE_SNAPSHOT_FROM_BLOCK=0
# 4x/day cadence; extra snapshot exclusions (comma list, e.g. the DEX pool).
TAX_DISTRIBUTION_MINUTES=360
HOLDER_EXCLUDE_ADDRESSES=
HOLDER_MIN_ROUND_RAW=
