{
  "name": "punchcard-server",
  "version": "0.1.0",
  "private": true,
  "description": "WALLETCHI server: pet mint relayer, Apple/Google Wallet passes, care actions, email.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && prisma migrate deploy && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "showcase:check": "tsx scripts/showcase-check.ts",
    "wallet-pass:check": "tsx scripts/wallet-pass-check.ts",
    "pass-bundle:check": "tsx scripts/pass-bundle-check.ts && tsx scripts/pass-bundle-check.ts --poster-on",
    "pass-time:check": "tsx scripts/pass-time-check.ts",
    "alive-count:check": "tsx scripts/alive-count-check.ts",
    "lockscreen:check": "tsx scripts/lockscreen-check.ts",
    "device-mark:check": "tsx scripts/device-mark-check.ts",
    "reminder-rearm:check": "tsx scripts/reminder-rearm-check.ts",
    "mint-store-failure:check": "tsx scripts/mint-store-failure-check.ts",
    "setup-nudge:check": "tsx scripts/setup-nudge-check.ts",
    "arming-report:check": "tsx scripts/arming-report-check.ts",
    "rotate-links:check": "tsx scripts/rotate-links-check.ts",
    "google-rotation:check": "tsx scripts/google-rotation-check.ts",
    "load:rehearsal": "tsx scripts/load-rehearsal.ts",
    "gift-pet:check": "tsx scripts/gift-pet-check.ts",
    "gas-withdraw:check": "tsx scripts/gas-withdraw-check.ts",
    "apns-session:check": "tsx scripts/apns-session-check.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@alchemy/wallet-apis": "^5.1.1",
    "@prisma/client": "^5.22.0",
    "@privy-io/server-auth": "^1.19.0",
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "node-forge": "^1.3.1",
    "passkit-generator": "^3.6.1",
    "pino": "^9.5.0",
    "resend": "^4.0.1",
    "sharp": "^0.33.5",
    "viem": "^2.21.54",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.9",
    "@types/node-forge": "^1.3.11",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
