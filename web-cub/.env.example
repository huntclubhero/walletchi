# The WALLETCHI API base (no trailing slash).
# Production is the Render server URL; set this in the Vercel project.
# Local dev falls back to http://localhost:8080 when unset.
NEXT_PUBLIC_API_URL=

# Canonical site origin for metadata / OG URLs.
# Falls back to https://www.playwalletchi.com when unset.
NEXT_PUBLIC_SITE_URL=

# Privy app id for email sign-in (the /me dashboard + non-custodial mints).
# Leave unset to keep sign-in in its gentle "warming up" state.
NEXT_PUBLIC_PRIVY_APP_ID=

# CARE token address once the token launches. While unset, the Uniswap swap
# and Pons buttons render in their "token launching soon" disabled state.
NEXT_PUBLIC_CARE_TOKEN_ADDRESS=

# Which Robinhood Chain the care flow targets: "mainnet" (4663) or "testnet" (46630).
# Defaults to testnet.
NEXT_PUBLIC_ROBINHOOD_NETWORK=

# PetVault address for the on-chain care() call (the account-abstraction care flow targets it).
NEXT_PUBLIC_PETVAULT_ADDRESS=

# --- Trustless gasless care (account abstraction). Both come from JP's Alchemy setup: an app for
# --- Robinhood Chain + a Gas Manager sponsorship policy linked to that app. Until both are set, the
# --- gasless care UI stays gated (AA_CARE_ENABLED=false) and nothing changes.
# Alchemy Wallet APIs key for the app the Gas Manager policy is linked to.
NEXT_PUBLIC_ALCHEMY_API_KEY=
# Alchemy Gas Manager sponsorship policy id (not a secret).
NEXT_PUBLIC_GAS_POLICY_ID=

# --- TAX ECONOMY (2026-08-17). The season's reward addresses live in the SERVER env; the web app
# --- only needs the season basics below (already set above as NEXT_PUBLIC_*_ADDRESS). This block
# --- exists so a fresh checkout knows the 2026-08-17 season introduced trading-fee rewards: holder
# --- airdrops are served by the API at /api/holder-rewards/:address (proofs + gasless claim relay)
# --- and player fee rewards ride the existing pet rewards read. No new web env is required.

# --- TAX ECONOMY reward tokens (for the pet-account withdraw button) ---
# USDG (the trade-tax holder-airdrop currency) + decimals, and CARE decimals, for reading and
# displaying a pet account's withdrawable reward balances. Empty until the season is wired.
NEXT_PUBLIC_FEE_TOKEN_ADDRESS=
NEXT_PUBLIC_FEE_TOKEN_DECIMALS=6
NEXT_PUBLIC_CARE_TOKEN_DECIMALS=18
