# WALLETCHI Testnet Showcase: DeployWalletchi parameters (Robinhood testnet 46630).
# Rationale for every value: TESTNET-SHOWCASE-RUNBOOK.md at the repo root.
# Secrets are NOT in this file: PRIVATE_KEY and POSTER are exported separately at deploy time.
ACCOUNT_IMPL=0xb73E98C4262d61C8Fbe6F60b2ea43B2621b4090D
PET_NAME=WALLETCHI
PET_SYMBOL=WCHI
BASE_URI=https://api.playwalletchi.com/metadata/runner/
CONTRACT_URI=https://api.playwalletchi.com/api/collection.json
# Wallet Pass Extension (ERC draft, 0xef5f1e71): the deploy appends eip155/<chainId>/<pet>/.
# MUST equal the API service PUBLIC_BASE_URL + "/wallet-pass/".
PASS_BASE_URI=https://api.playwalletchi.com/wallet-pass/
MAX_SUPPLY=1000
SELLOUT_STARTS_SEASON=false
LIFE_TTL=86400
ENTRY_WINDOW_SECS=5184000
MIN_SEASON_DURATION=5184000
MIN_PLAYERS=3
ABANDON_GRACE=604800
MINT_BUDGET_MAX=200
MINT_BUDGET_WINDOW=3600
CARE_COST=1000000000000000000
PER_TX_CAP=1000000000000000000
DAILY_CAP=500000000000000000000
CARE_COOLDOWN=0
STARTER_TOKENS=500000000000000000000
MOCK_CARE_FLOAT=600000000000000000000000
POT_BPS=1000
REWARDS_BPS=2000
GAS_BPS=100
EPOCH_LENGTH=7200
REWARDS_DUST=0
